@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title "C4 Model - Диаграмма Компонентов - Платформа Данных и Аналитики"

Container_Boundary(data_platform, "Платформа Данных и Аналитики") {

    Component(api_gateway, "API Gateway", "Go/Kong", "Точка входа для UI Портала Данных и внешних аналитических инструментов")
    Component(auth_component, "Компонент Аутентификации", "Keycloak adapter", "Обработка аутентификации пользователей и RBAC")

    Boundary(stream_processing_layer, "Слой Потоковой Обработки") {
        Component(kafka_consumer, "Kafka Consumer", "Flink/Spark Streaming", "Потребляет сырые события из Шины Событий")
        Component(data_transformer, "Трансформер Данных", "SQL/Python", "Очищает, обогащает и трансформирует данные")
        Component(data_quality_check, "Проверка Качества Данных", "Great Expectations", "Валидирует схему данных и бизнес-правила")
    }

    Boundary(storage_layer, "Слой Хранения") {
        ComponentDb(data_lake_s3, "Озеро Данных (S3)", "MinIO/S3", "Зоны: Бронза (Сырые), Серебро (Очищенные), Золото (Агрегированные)")
        ComponentDb(clickhouse, "Витрина Данных (ClickHouse)", "ClickHouse", "Высокопроизводительная OLAP БД для аналитики в реальном времени")
        ComponentDb(metadata_store, "Хранилище Метаданных", "PostgreSQL", "Хранит информацию о каталоге, правах пользователей, конфигах отчетов")
    }

    Boundary(serving_layer, "Слой Обслуживания (Serving)") {
        Component(query_engine, "Движок Запросов / API", "FastAPI/Trino", "Выполняет SQL запросы к Витринам и Озеру Данных")
        Component(catalog_service, "Сервис Каталога Данных", "OpenMetadata/Amundsen", "Обеспечивает поиск и обнаружение активов данных")
        Component(visualization_engine, "Движок Визуализации", "Superset/Metabase (embedded)", "Рендерит графики и дашборды")
    }
}

Rel(api_gateway, auth_component, "Валидирует токен")
Rel(api_gateway, query_engine, "Проксирует запросы на данные")
Rel(api_gateway, catalog_service, "Проксирует запросы к каталогу")
Rel(api_gateway, visualization_engine, "Проксирует запросы к дашбордам")

Rel(kafka_consumer, data_transformer, "Передает события")
Rel(data_transformer, data_quality_check, "Валидирует данные")
Rel(data_transformer, data_lake_s3, "Пишет в зоны Silver/Gold")
Rel(data_transformer, clickhouse, "Пишет агрегаты реального времени")

Rel(query_engine, clickhouse, "SQL Запросы (Горячий путь)")
Rel(query_engine, data_lake_s3, "SQL Запросы (Холодный путь / Trino)")
Rel(catalog_service, metadata_store, "Читает/Пишет Метаданные")
Rel(visualization_engine, query_engine, "Запрашивает данные для графиков")

@enduml
